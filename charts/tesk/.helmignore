# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Values with credentials, passed with `-f`, and a TLS secret made from
# `tls-secret.yaml-TEMPLATE`, applied with kubectl; the chart reads neither.
# `ftp/.netrc` and `s3-config/` hold credentials too, but stay: the chart
# reads them (`.Files.Get`), and Helm ignores these patterns also when it
# installs from this directory. Package from a clean checkout
secrets.yaml
tls-secret.yaml

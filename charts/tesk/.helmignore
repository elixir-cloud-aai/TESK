# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Values with credentials, passed with `-f` (see docs/deployment.md), which
# the chart doesn't read. `ftp/.netrc` and `s3-config/config` and
# `credentials` hold credentials too, but the chart reads them
# (`.Files.Get`), and Helm leaves ignored files out also when it installs
# from this directory: build packages for others from a clean checkout
secrets.yaml

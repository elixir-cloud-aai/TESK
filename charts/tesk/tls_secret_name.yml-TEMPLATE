apiVersion: v1
stringData:
  tls.crt: |-
    -----BEGIN CERTIFICATE-----
    <base64 lines of the certificate>
    -----END CERTIFICATE-----
  tls.key: |-
    -----BEGIN PRIVATE KEY-----
    <base64 lines of the private key>
    -----END PRIVATE KEY-----
kind: Secret
metadata:
  name: tls_secret
type: kubernetes.io/tls

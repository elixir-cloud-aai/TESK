{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "Permissive on purpose: it checks the types of the values only, accepts strings for scalars (for tools that set only strings) and unknown keys, and still accepts the deprecated keys of earlier versions of the chart (see tesk.renamedValues in templates/_helpers.tpl), so that existing values files keep working",
  "type": "object",
  "$defs": {
    "text": {
      "type": ["string", "null"]
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "number": {
      "type": ["number", "string", "null"]
    },
    "flag": {
      "type": ["boolean", "string", "null"]
    },
    "map": {
      "type": ["object", "null"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Image repository, without the tag"
        },
        "tag": {
          "$ref": "#/$defs/scalar",
          "description": "Image tag"
        }
      }
    },
    "resourceList": {
      "type": ["object", "null"],
      "additionalProperties": {
        "$ref": "#/$defs/number"
      }
    }
  },
  "properties": {
    "hostName": {
      "$ref": "#/$defs/text",
      "description": "Host name (FQDN) of the API, for the Ingress or the OpenShift Route"
    },
    "host_name": {
      "$ref": "#/$defs/text",
      "description": "Deprecated: use hostName"
    },
    "storage": {
      "$ref": "#/$defs/text",
      "description": "Storage backend that the chart sets up: s3, openstack, or anything else for none"
    },
    "storageClass": {
      "$ref": "#/$defs/text",
      "description": "Storage class of the tasks' PVCs; empty uses the cluster's default class"
    },
    "tesk": {
      "type": "object",
      "properties": {
        "image": {
          "description": "Image of the API: a map of repository, tag and pull policy, or (deprecated) a string with the tag",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "$ref": "#/$defs/scalar"
                },
                "pullPolicy": {
                  "enum": ["Always", "IfNotPresent", "Never", "", null]
                }
              }
            }
          ]
        },
        "port": {
          "type": ["integer", "string"],
          "description": "Port of the API's container and Service"
        },
        "tesApiBasePath": {
          "$ref": "#/$defs/text",
          "description": "Base path of the TES API"
        },
        "tes_api_base_path": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use tesk.tesApiBasePath"
        },
        "taskmaster": {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/$defs/image"
            }
          }
        },
        "filer": {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/$defs/image"
            }
          }
        },
        "taskmaster_image_name": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use tesk.taskmaster.image.repository"
        },
        "taskmaster_image_version": {
          "$ref": "#/$defs/scalar",
          "description": "Deprecated: use tesk.taskmaster.image.tag"
        },
        "taskmaster_filer_image_name": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use tesk.filer.image.repository"
        },
        "taskmaster_filer_image_version": {
          "$ref": "#/$defs/scalar",
          "description": "Deprecated: use tesk.filer.image.tag"
        },
        "debug": {
          "$ref": "#/$defs/flag",
          "description": "Debug logging in the taskmasters"
        },
        "executorRetries": {
          "$ref": "#/$defs/number",
          "description": "Retries of an executor's job on errors"
        },
        "executor_retries": {
          "$ref": "#/$defs/number",
          "description": "Deprecated: use tesk.executorRetries"
        },
        "filerRetries": {
          "$ref": "#/$defs/number",
          "description": "Retries of a filer's job on errors"
        },
        "filer_retries": {
          "$ref": "#/$defs/number",
          "description": "Deprecated: use tesk.filerRetries"
        },
        "resources": {
          "type": ["object", "null"],
          "description": "Resources of the API's container (requests and limits)",
          "properties": {
            "limits": {
              "$ref": "#/$defs/resourceList"
            },
            "requests": {
              "$ref": "#/$defs/resourceList"
            }
          }
        },
        "limitsCpu": {
          "$ref": "#/$defs/number",
          "description": "Deprecated: use tesk.resources.limits.cpu"
        },
        "limitsMemory": {
          "$ref": "#/$defs/number",
          "description": "Deprecated: use tesk.resources.limits.memory"
        },
        "requestsCpu": {
          "$ref": "#/$defs/number",
          "description": "Deprecated: use tesk.resources.requests.cpu"
        },
        "requestsMemory": {
          "$ref": "#/$defs/number",
          "description": "Deprecated: use tesk.resources.requests.memory"
        },
        "securityContext": {
          "type": "object",
          "description": "Security context of the API (enabled)"
        },
        "swaggerUi": {
          "description": "Swagger UI of the API (enabled: true or false); checked by the templates"
        }
      }
    },
    "transfer": {
      "type": "object",
      "properties": {
        "active": {
          "$ref": "#/$defs/flag",
          "description": "Support for file: URLs on a shared PVC"
        },
        "wesBasePath": {
          "$ref": "#/$defs/text",
          "description": "Path where the workflow engine sees the shared volume"
        },
        "wes_base_path": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use transfer.wesBasePath"
        },
        "tesBasePath": {
          "$ref": "#/$defs/text",
          "description": "Path where the filer mounts the shared PVC"
        },
        "tes_base_path": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use transfer.tesBasePath"
        },
        "pvcName": {
          "$ref": "#/$defs/text",
          "description": "Name of the shared PVC"
        },
        "pvc_name": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use transfer.pvcName"
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/text",
          "description": "auth requires OIDC access tokens; noauth leaves all endpoints open"
        },
        "envSubgroup": {
          "$ref": "#/$defs/text",
          "description": "Subgroup of the base group for this deployment"
        },
        "env_subgroup": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use auth.envSubgroup"
        },
        "envBasegroup": {
          "$ref": "#/$defs/text",
          "description": "Base group of the LS Login group model that grants access"
        },
        "env_basegroup": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use auth.envBasegroup"
        },
        "serviceInfoPublic": {
          "$ref": "#/$defs/flag",
          "description": "With mode auth, whether GET /service-info answers without a token"
        },
        "service_info_public": {
          "$ref": "#/$defs/flag",
          "description": "Deprecated: use auth.serviceInfoPublic"
        },
        "clientId": {
          "$ref": "#/$defs/scalar",
          "description": "ID of the OIDC client of the Swagger UI"
        },
        "client_id": {
          "$ref": "#/$defs/scalar",
          "description": "Deprecated: use auth.clientId"
        },
        "clientSecret": {
          "$ref": "#/$defs/scalar",
          "description": "Secret of the OIDC client of the Swagger UI"
        },
        "client_secret": {
          "$ref": "#/$defs/scalar",
          "description": "Deprecated: use auth.clientSecret"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/text",
          "description": "Type of the API's Service: NodePort, LoadBalancer, or empty for ClusterIP"
        },
        "nodePort": {
          "$ref": "#/$defs/number",
          "description": "Node port with type NodePort"
        },
        "node_port": {
          "$ref": "#/$defs/number",
          "description": "Deprecated: use service.nodePort"
        }
      }
    },
    "ftp": {
      "type": "object",
      "properties": {
        "classicFtpSecret": {
          "$ref": "#/$defs/text",
          "description": "Name of the secret with the FTP username and password; empty creates none"
        },
        "classic_ftp_secret": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use ftp.classicFtpSecret"
        },
        "netrcSecret": {
          "$ref": "#/$defs/text",
          "description": "Name of the secret with a .netrc file; empty creates none"
        },
        "netrc_secret": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use ftp.netrcSecret"
        },
        "username": {
          "$ref": "#/$defs/scalar",
          "description": "FTP username"
        },
        "password": {
          "$ref": "#/$defs/scalar",
          "description": "FTP password"
        },
        "hostip": {
          "$ref": "#/$defs/text",
          "description": "IP of an FTP server outside the cluster, as pods see the host"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "rules": {
          "$ref": "#/$defs/flag",
          "description": "Creates an Ingress; false creates an OpenShift Route instead, on OpenShift"
        },
        "ingressClassName": {
          "$ref": "#/$defs/text",
          "description": "Ingress class"
        },
        "path": {
          "$ref": "#/$defs/text",
          "description": "Path of the Ingress, and the context path of the API"
        },
        "tlsSecretName": {
          "$ref": "#/$defs/text",
          "description": "Secret with the TLS certificate of hostName; empty switches TLS off"
        },
        "tls_secret_name": {
          "$ref": "#/$defs/text",
          "description": "Deprecated: use ingress.tlsSecretName"
        },
        "annotations": {
          "$ref": "#/$defs/map",
          "description": "Annotations of the Ingress"
        }
      }
    }
  }
}

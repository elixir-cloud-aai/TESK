# The build context of `containers/*.Dockerfile` (`dockerBuild`,
# `cloudbuild.yaml`), without local environments, caches and build output
.coverage
.pytest_cache/
.tox/
.eggs/
**/__pycache__/
build/
dist/
# Secrets never go into the images, nor into the build stages and their
# cache: at any depth (see `tests/test_dockerignore.py` at the repository
# root)
**/.env
**/.env.*
!**/.env.example
**/.netrc
**/.git-credentials
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*
**/kubeconfig*

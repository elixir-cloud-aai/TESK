# The build context of `containers/*.Dockerfile` (`dockerBuild`,
# `cloudbuild*.yaml`), without caches and build output
.coverage
.pytest_cache/
.tox/
.eggs/
**/__pycache__/
build/
dist/
# Secrets never go into the images, nor into the build stages and their
# cache: at any depth (the same rules as in the `.dockerignore` at the
# repository root, checked by `tests/test_dockerignore.py` there)
**/.env*
!**/.env.example
**/.env.example/**
**/.git
**/.ssh
**/.config/gcloud
**/application_default_credentials.json
**/.netrc
**/.git-credentials
**/.pypirc
**/.npmrc
**/.aws
**/.docker/config.json
**/.kube
**/*kubeconfig*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_dsa*
**/id_ecdsa*
**/id_ed25519*
**/*secret*.yaml
**/*secret*.yml
